{
  "name": "wrapped-sncf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:stations": "node scripts/build-stations.mjs",
    "inspect": "vite-node scripts/inspect-csv.ts --",
