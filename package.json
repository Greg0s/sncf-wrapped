  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
